# Main configuration file for Crypto Treasury Parser scripts
# Copy this to config.yaml and customize as needed

# API keys are loaded from environment variables (.env file)
# This config file is for script-specific settings

# Ingestion settings
ingest:
  hours: 24  # Hours to look back when ingesting news

# Classification settings
classify:
  limit_files: null  # null = process all files
  workers: 5  # Number of parallel workers for GPT classification
  export_positives: true  # Automatically export positive classifications

# Formatting settings
format:
  limit_files: null  # null = process all files
  orig_only: true  # Only process .orig.txt files (not .txt)

# Enrichment settings
enrich:
  limit_files: null  # null = process all files
  as_of: null  # ISO datetime string (null = use current time)
  enrich_stock: true  # Enrich stock prices
  enrich_token: true  # Enrich token prices

# Deduplication settings
dedup:
  keep: largest  # Strategy: largest, newest, most_filled, first
  require_all: true  # Require stock, token, and date to deduplicate
  remove_duplicates: false  # Delete duplicates (false = move to trash)
  include_related: true  # Also move/delete related files (.orig.txt, etc.)
  dry_run: false  # Only report, don't modify files

# CSV export settings
export_csv:
  output_file: null  # null = auto-generate filename
  exclude_no_token: true  # Exclude entries where Token is N/A


# Pipeline configuration file
# Copy this to pipeline_config.yaml and customize as needed

# Pipeline-wide settings
pipeline:
  # Skip specific steps (useful for resuming)
  skip_steps: []  # Options: ingest, classify, format, enrich, dedup, export_csv
  
  # Continue from existing directory (skip ingest/classify)
  continue_from_dir: null  # e.g., "positive_DAT/20251120_190823Z"

# Step 1: Ingestion
ingest:
  hours: 720  # Hours to look back (max 720 = 30 days)

# Step 2: Classification
classify:
  limit_files: null  # null = process all files
  workers: 5  # Parallel workers for GPT classification
  export_positives: true  # Export positive classifications to positive_DAT/

# Step 3: Formatting
format:
  limit_files: null  # null = process all files
  orig_only: true  # Only process .orig.txt files

# Step 4: Enrichment
enrich:
  limit_files: null  # null = process all files
  as_of: null  # ISO datetime string (null = use current time)
  enrich_stock: true  # Enrich with Alpha Vantage stock prices
  enrich_token: true  # Enrich with CoinGecko token prices

# Step 5: Deduplication
dedup:
  keep: largest  # Strategy: largest, newest, most_filled, first
  require_all: true  # Require stock, token, and date to deduplicate
  remove_duplicates: false  # Delete duplicates (false = move to _dedup_trash/)
  include_related: true  # Also move/delete related files (.orig.txt, etc.)
  dry_run: false  # Only report, don't modify files

# Step 6: CSV Export
export_csv:
  output_file: null  # null = auto-generate: {dir_name}_combined_final.csv
  exclude_no_token: true  # Exclude entries where Token is N/A

